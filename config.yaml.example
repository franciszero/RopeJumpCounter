# RopeJumpCounter 配置文件示例
# 复制此文件为 config.yaml 并根据需要修改

# 摄像头配置
camera:
  width: 640              # 视频宽度
  height: 480             # 视频高度
  fps: 30                 # 帧率
  device_index: 0         # 摄像头设备索引 (0, 1, 2...)

# 模型配置
model:
  model_name: "best_cnn8_ws4_withT.keras"  # 模型文件名
  threshold: 0.5          # 跳跃检测阈值 (0.0-1.0)

# 日志配置
logging:
  enabled: true           # 是否启用日志
  log_dir: "logs"         # 日志目录
  level: "INFO"           # 日志级别: DEBUG, INFO, WARNING, ERROR

# 视频保存路径 (可选)
save_video_path: null     # 设置路径以启用视频录制，如: "data/recordings"

# GPU 配置 (可选)
gpu:
  enabled: true           # 是否启用 GPU 加速
  memory_growth: true     # 是否启用内存增长
  mixed_precision: true   # 是否启用混合精度

# 性能配置
performance:
  stats_window_size: 10   # 性能统计窗口大小
  max_fps: 30            # 最大处理帧率

# 特征提取配置
features:
  window_size: 4          # 时间窗口大小
  stabilizer_enabled: true # 是否启用视频稳定
  
# UI 配置
ui:
  zoom_height: 920        # 显示窗口高度
  show_debug_info: true   # 是否显示调试信息
  
# 数据路径配置
paths:
  model_files: "model_files"
  data_dir: "data"
  raw_videos: "data/raw_videos"
  datasets: "data/datasets"
